<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="rps.controllers.GameController">
   <children>
      <VBox alignment="CENTER" prefHeight="850.0" prefWidth="850.0" StackPane.alignment="CENTER">
         <StackPane.margin>
            <Insets bottom="10.0" left="5.0" right="5.0" top="10.0" />
         </StackPane.margin>
         <padding>
            <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
         </padding>
         <children>
            <Label prefHeight="67.0" text="Rock-Paper-Scissors">
               <font>
                  <Font name="System Bold" size="34.0" />
               </font>
            </Label>
            <Label fx:id="roundLabel" text="Round: 1">
               <font>
                  <Font size="26.0" />
               </font>
            </Label>
            <Label prefHeight="44.0" text="Choose Rock, Paper, or Scissors">
               <font>
                  <Font size="20.0" />
               </font>
            </Label>
            <HBox alignment="CENTER" prefHeight="79.0" prefWidth="838.0" spacing="25.0">
               <children>
                  <Button fx:id="rockButton"
                          mnemonicParsing="false"
                          onAction="#handleRock"
                          prefHeight="45.0"
                          prefWidth="113.0"
                          text="Rock">
                     <font>
                        <Font size="15.0" />
                     </font></Button>
                  <Button fx:id="paperButton"
                          mnemonicParsing="false"
                          onAction="#handlePaper"
                          prefHeight="45.0"
                          prefWidth="113.0"
                          text="Paper">
                     <font>
                        <Font size="15.0" />
                     </font></Button>
                  <Button fx:id="scissorsButton"
                          mnemonicParsing="false"
                          onAction="#handleScissors"
                          prefHeight="45.0"
                          prefWidth="113.0"
                          text="Scissors">
                     <font>
                        <Font size="15.0" />
                     </font></Button>
               </children>
            </HBox>
            <HBox alignment="CENTER" spacing="10">
               <children>
                  <Label prefHeight="46.0" text="Human Choice: ">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="humanMoveLabel">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
               </children>
            </HBox>

            <Separator prefWidth="700.0" />

            <VBox alignment="CENTER" prefHeight="141.0" prefWidth="838.0">
               <children>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Label prefHeight="46.0" text="Computer's prediction:">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                        <Label fx:id="predictedMoveLabel">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>

                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Label prefHeight="47.0" text="Computer's Choice: ">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                        <Label fx:id="computerMoveLabel">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>

                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <Label prefHeight="46.0" text="Round Result: ">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                        <Label fx:id="roundWinnerLabel">
                           <font>
                              <Font size="18.0" />
                           </font>
                        </Label>
                     </children>
                  </HBox>

               </children>
            </VBox>
            <Separator prefWidth="700.0" />
            <HBox alignment="CENTER" prefHeight="54.0" prefWidth="835.0" spacing="15.0">
               <children>
                  <Label prefHeight="36.0" prefWidth="107.0" text="Human Wins:">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="humanWinsLabel" text="0">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label text="|">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label prefHeight="42.0" prefWidth="128.0" text="Computer Wins:">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="computerWinsLabel" text="0">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label text="|">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label prefHeight="44.0" prefWidth="49.0" text="Draw:">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="drawsLabel" text="0">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <Separator prefWidth="700.0" />

            <VBox fx:id="gameOverVBox" alignment="CENTER" disable="true" opacity="0.0" prefWidth="300.0" spacing="12.0">
               <children>
                  <Label text="Game Winner:">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Label>
                  <Label fx:id="gameWinnerLabel" text="N/A">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Label>

                  <HBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#handlePlayAgain" text="Play Again" />
                        <Button mnemonicParsing="false" onAction="#switchToMenu" text="Menu" />
                        <Button mnemonicParsing="false" onAction="#exitGame" text="Exit" />
                     </children>
                  </HBox>
               </children>
            </VBox>

         </children>
      </VBox>
   </children>
</StackPane>