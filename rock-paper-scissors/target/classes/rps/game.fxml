<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.TextFlow?>

<StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="353.0" prefWidth="417.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="rps.controllers.GameController">
   <children>
      <VBox alignment="CENTER" prefHeight="102.0" prefWidth="186.0" StackPane.alignment="CENTER">
         <children>
            <Label fx:id="roundLabel" alignment="BOTTOM_CENTER" prefHeight="37.0" prefWidth="98.0" text="Round: " textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <padding>
                  <Insets bottom="20.0" />
               </padding>
            </Label>
            <Label prefHeight="27.0" prefWidth="180.0" text="Human Player Move:">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Label>
            <ButtonBar prefHeight="40.0" prefWidth="405.0">
              <buttons>
                  <Label text="Choose:" />
                <Button fx:id="rockButton" mnemonicParsing="false" text="Rock" />
                  <Button fx:id="paperButton" mnemonicParsing="false" text="Paper" />
                  <Button fx:id="scissorsButton" mnemonicParsing="false" text="Scissors" />
              </buttons>
               <VBox.margin>
                  <Insets bottom="5.0" left="50.0" right="5.0" top="5.0" />
               </VBox.margin>
               <padding>
                  <Insets right="60.0" />
               </padding>
            </ButtonBar>
            <TextFlow prefHeight="20.0" prefWidth="465.0" textAlignment="CENTER">
               <children>
                  <Label prefHeight="17.0" prefWidth="131.0" text="Human Player Choose: " />
                  <Label fx:id="humanMoveLabel" prefHeight="17.0" prefWidth="51.0" />
               </children>
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </TextFlow>
            <Label prefHeight="27.0" prefWidth="204.0" text="Computer Player Move:">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" top="10.0" />
               </VBox.margin>
            </Label>
            <TextFlow prefHeight="20.0" prefWidth="465.0" textAlignment="CENTER">
               <children>
                  <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="179.0" text="Predicted human choice: " />
                  <Label fx:id="predictedMoveLabel" alignment="CENTER" prefHeight="17.0" prefWidth="47.0" />
               </children>
            </TextFlow>
            <TextFlow prefHeight="20.0" prefWidth="465.0" textAlignment="CENTER">
               <children>
                  <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="180.0" text="Therefore, computer choose:" />
                  <Label fx:id="computerMoveLabel" alignment="CENTER" prefHeight="17.0" prefWidth="52.0" />
               </children>
            </TextFlow>
            <TextFlow prefHeight="36.0" prefWidth="465.0" textAlignment="CENTER">
               <children>
                  <Label prefHeight="27.0" prefWidth="145.0" text="Round Winner:">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label prefHeight="17.0" prefWidth="96.0" />
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" top="20.0" />
               </VBox.margin>
            </TextFlow>
            <Label prefHeight="27.0" prefWidth="120.0" text="Current Stats:">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <TextFlow prefHeight="17.0" prefWidth="465.0" textAlignment="CENTER">
               <children>
                  <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="119.0" text="Human Player Wins:" textAlignment="RIGHT" />
                  <Label fx:id="humanWinsLabel" alignment="CENTER" prefHeight="17.0" prefWidth="47.0" text="0" />
               </children>
            </TextFlow>
            <TextFlow prefHeight="21.0" prefWidth="465.0" textAlignment="CENTER">
               <children>
                  <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="121.0" text="Computer Player Wins:" />
                  <Label fx:id="computerWinsLabel" alignment="CENTER" prefHeight="17.0" prefWidth="46.0" text="0" />
               </children>
            </TextFlow>
            <TextFlow prefHeight="9.0" prefWidth="465.0" textAlignment="CENTER">
               <children>
                  <Label alignment="CENTER_RIGHT" prefHeight="17.0" prefWidth="122.0" text="Ties: " textAlignment="RIGHT" />
                  <Label fx:id="tiesLabel" alignment="CENTER" prefHeight="17.0" prefWidth="40.0" text="0" />
               </children>
            </TextFlow>
         </children>
      </VBox>
   </children>
</StackPane>
