<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="204.0" prefWidth="229.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="rps.controllers.GameOptionsController">
   <children>
      <VBox alignment="CENTER" prefHeight="198.0" prefWidth="234.0" StackPane.alignment="CENTER">
         <children>
            <Label prefHeight="37.0" prefWidth="83.0" text="Game Options" textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
               <padding>
                  <Insets bottom="20.0" />
               </padding>
            </Label>
            <Label prefHeight="20.0" prefWidth="126.0" text="Number of rounds:">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
            <ComboBox fx:id="numRoundsComboBox" prefHeight="25.0" prefWidth="70.0" promptText="20" visibleRowCount="7">
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </ComboBox>
            <Button fx:id="enterGameButton" mnemonicParsing="false" onAction="#switchToGame" prefHeight="35.0" prefWidth="132.0" text="Enter Game">
               <VBox.margin>
                  <Insets top="30.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>
