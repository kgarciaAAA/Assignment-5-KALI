<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="rps.controllers.MenuController">

    <children>
        <VBox alignment="CENTER" spacing="20.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
         <Label text="Rock Paper Scissor Game">
            <font>
               <Font name="System Bold" size="41.0" />
            </font>
         </Label>

            <Label text="Main Menu">
                <font>
                    <Font name="System Bold" size="32.0" />
                </font>
            </Label>

            <Label text="Please select a menu option:">
                <font>
                    <Font size="18.0" />
                </font>
            </Label>

            <Button fx:id="newGameButton" mnemonicParsing="false" onAction="#switchToGameOptions" prefHeight="50.0" prefWidth="176.0" text="New Game" />

            <Button fx:id="aboutButton" mnemonicParsing="false" onAction="#switchToAbout" prefHeight="50.0" prefWidth="180.0" text="About" />

            <Button fx:id="exitButton" mnemonicParsing="false" onAction="#exitGame" prefHeight="50.0" prefWidth="183.0" text="Exit" />
        </VBox>
    </children>
</StackPane>
