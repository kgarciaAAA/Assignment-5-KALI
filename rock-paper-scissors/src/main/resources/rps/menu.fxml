<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="160.0" prefWidth="248.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="rps.controllers.MenuController">
   <children>
      <VBox alignment="CENTER" prefHeight="102.0" prefWidth="186.0" StackPane.alignment="CENTER">
         <children>
            <Label prefHeight="17.0" prefWidth="67.0" text="Main Menu" textAlignment="CENTER" textOverrun="CENTER_ELLIPSIS">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="40.0" top="20.0" />
               </VBox.margin>
            </Label>
            <Label text="Please select a menu option:" textAlignment="CENTER">
               <VBox.margin>
                  <Insets />
               </VBox.margin>
               <padding>
                  <Insets bottom="20.0" top="20.0" />
               </padding>
            </Label>
            <Button fx:id="newGameButton" mnemonicParsing="false" onAction="#switchToGameOptions" prefHeight="35.0" prefWidth="132.0" text="New Game" textAlignment="CENTER">
               <VBox.margin>
                  <Insets bottom="20.0" top="20.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="aboutButton" mnemonicParsing="false" onAction="#switchToAbout" prefHeight="35.0" prefWidth="132.0" text="About" textAlignment="CENTER">
               <VBox.margin>
                  <Insets bottom="20.0" top="20.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="exitButton" mnemonicParsing="false" onAction="#exitGame" prefHeight="35.0" prefWidth="132.0" text="Exit" textAlignment="CENTER">
               <VBox.margin>
                  <Insets bottom="20.0" top="20.0" />
               </VBox.margin>
            </Button>
         </children>
         <StackPane.margin>
            <Insets bottom="20.0" top="20.0" />
         </StackPane.margin>
      </VBox>
   </children>
</StackPane>
